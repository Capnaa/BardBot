<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JDA narrates its websocket at INFO. Useful once, noise thereafter. -->
    <logger name="net.dv8tion.jda" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
